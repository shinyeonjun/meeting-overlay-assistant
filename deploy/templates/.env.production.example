APP_ENV=production
DEBUG=false
SERVER_HOST=127.0.0.1

AUTH_ENABLED=true
AUTH_SESSION_TTL_HOURS=12

# 비밀 값은 배포 환경의 시크릿 저장소나 환경 변수로 주입한다.
POSTGRESQL_DSN=
REDIS_URL=
LIVE_QUESTION_LLM_API_KEY=
STT_API_KEY=
SPEAKER_DIARIZER_AUTH_TOKEN=

# 외부 STT API를 쓰려면 true로 바꾼다. 기본은 로컬 전용이다.
STT_ALLOW_REMOTE=false

# 허용할 출처만 적는다.
CORS_ALLOWED_ORIGINS=